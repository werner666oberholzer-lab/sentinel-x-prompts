  "templates": ["templates/architecture-decision-record.md", "templates/phase-execution-request.md", "templates/phase-completion-report.md", "templates/threat-model-entry.md", "templates/security-review-checklist.md", "templates/quality-gate-report.md"],
  "validation": {"required_files": "validation/required-files.txt", "quality_checklist": "validation/prompt-quality-checklist.md"},
  "security_model": {"authorization": "Security Governor", "default_policy": "deny-by-default", "capability_rule": "NO CAPABILITY = NO ACTION", "ai_is_trust_anchor": false},
