{
  "package_name": "sentinel-x-prompts",
  "display_name": "SENTINEL-X Copilot Prompt Package",
  "version": "1.0.0",
  "description": "Governed architecture and implementation prompts for the SENTINEL-X AI operating environment.",
  "prompt_runtime": ["GitHub Copilot Agent Mode", "Visual Studio Code"],
  "entry_points": {"bootstrap": "prompts/02-sentinel-x-architecture-security-bootstrap.md", "implementation": "prompts/03-sentinel-x-platform-implementation.md"},
